generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  username           String        @unique
  passwordHash       String
  avatarColor        String        @default("#4F46E5")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  // Notifications
  // pushToken      : token Expo mobile (ExponentPushToken[...])
  // webPushToken   : abonnement Web Push (JSON stringifié, navigateur)
  pushToken          String?
  webPushToken       String?
  notifExpense       Boolean       @default(false)
  notifReminder      Boolean       @default(false)
  // Préférences
  preferredLanguage  String?       @default("fr")
  preferredCurrency  String?       @default("CHF")
  // Auth
  supabaseId         String?       @unique
  groupMembers       GroupMember[]
  refreshTokens      RefreshToken[]
  resetToken         String?       @unique
  resetTokenExpiry   DateTime?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Group {
  id         String        @id @default(cuid())
  name       String
  emoji      String        @default("💰")
  inviteCode String        @unique @default(cuid())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  expenses   Expense[]
  members    GroupMember[]

  @@map("groups")
}

model GroupMember {
  id              String                  @id @default(cuid())
  groupId         String
  userId          String?
  displayName     String
  avatarColor     String                  @default("#4F46E5")
  avatarInitials  String
  joinedAt        DateTime                @default(now())
  itemAssignments ExpenseItemAssignment[]
  splits          ExpenseSplit[]
  payments        ExpensePayment[]
  expenses        Expense[]               // relation paidByMemberId
  createdExpenses Expense[]               @relation("createdByMember")  // ← AJOUTER
  group           Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user            User?                   @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("group_members")
}

model Expense {
  id                String           @id @default(cuid())
  groupId           String
  description       String
  totalAmount       Float
  currency          String           @default("CHF")
  paidByMemberId    String
  splitType         SplitType        @default(EQUAL)
  receiptImageUrl   String?
  receiptImageKey   String?
  ocrConfidence     Float?
  note              String?
  isComplete        Boolean          @default(false)
  createdByMemberId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  items             ExpenseItem[]
  splits            ExpenseSplit[]
  payments          ExpensePayment[]
  group             Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  group_members     GroupMember      @relation(fields: [paidByMemberId], references: [id])
  createdBy         GroupMember?     @relation("createdByMember", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model ExpensePayment {
  id        String      @id @default(cuid())
  expenseId String
  memberId  String
  amount    Float
  expense   Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member    GroupMember @relation(fields: [memberId], references: [id])

  @@unique([expenseId, memberId])
  @@map("expense_payments")
}

model ExpenseItem {
  id            String                  @id @default(cuid())
  expenseId     String
  name          String
  price         Float
  ocrRaw        String?
  ocrConfidence Float?
  corrected     Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  assignedTo    ExpenseItemAssignment[]
  expense       Expense                 @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@map("expense_items")
}

model ExpenseItemAssignment {
  id       String      @id @default(cuid())
  itemId   String
  memberId String
  item     ExpenseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  member   GroupMember @relation(fields: [memberId], references: [id])

  @@unique([itemId, memberId])
  @@map("expense_item_assignments")
}

model ExpenseSplit {
  id        String      @id @default(cuid())
  expenseId String
  memberId  String
  amount    Float
  // Un remboursement n'est acquis que lorsque les DEUX parties l'ont confirme :
  // celui qui doit ("j'ai rembourse") et celui qui a avance ("j'ai ete paye").
  // `settled` reste le drapeau derive des deux, pour le reste du code.
  settled   Boolean     @default(false)
  settledAt DateTime?
  settledByDebtorAt   DateTime?
  settledByCreditorAt DateTime?
  createdAt DateTime    @default(now())
  expense   Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member    GroupMember @relation(fields: [memberId], references: [id])

  @@unique([expenseId, memberId])
  @@map("expense_splits")
}

model OcrCorrection {
  id             String   @id @default(cuid())
  receiptId      String?
  ocrRaw         String
  ocrPriceRaw    String
  correctedName  String
  correctedPrice Float
  confidence     Float
  vendorHint     String?
  deviceId       String?
  appVersion     String?
  trained        Boolean  @default(false)
  trainingRunId  String?
  createdAt      DateTime @default(now())

  @@index([trained])
  @@map("ocr_corrections")
}

model OcrTrainingRun {
  id              String   @id @default(cuid())
  version         Int      @default(0)          // monotically increasing artifact version
  active          Boolean  @default(false)      // exactly one active run = what inference uses
  kind            String   @default("rules")    // "rules" | "model"
  correctionCount Int                            // corrections seen when this run was built
  ruleCount       Int      @default(0)           // rules produced (kind=rules)
  modelRepo       String?                        // HF Hub repo (kind=model), e.g. "you/splitit-ocr"
  modelRevision   String?                        // model revision/tag (kind=model), e.g. "v3"
  status          String   @default("pending")  // pending|evaluated|promoted|skipped|failed
  trigger         String   @default("cron")     // cron|manual|api|ci
  precisionName   Float?                         // holdout accuracy on item names [0..1]
  precisionPrice  Float?                         // holdout accuracy on prices [0..1]
  metrics         Json?                          // full metrics blob
  datasetUrl      String?                        // optional JSONL export path
  notes           String?
  exportedAt      DateTime @default(now())

  rules           OcrCorrectionRule[]

  @@index([active])
  @@map("ocr_training_runs")
}

// Aggregated, deterministic correction rule learned from user feedback.
// Applied at inference time by the correction engine (free, no external model).
model OcrCorrectionRule {
  id            String   @id @default(cuid())
  runId         String
  version       Int                              // == OcrTrainingRun.version, for fast active lookup
  keyNorm       String                           // normalized OCR raw text (the lookup key)
  vendorNorm    String   @default("")            // normalized vendor hint, "" = vendor-agnostic
  correctedName String                           // majority-vote corrected name
  priceHint     Float?                           // stable modal price, if any (low-priority fallback)
  support       Int                              // number of corrections backing this rule
  confidence    Float                            // agreement ratio [0..1]
  createdAt     DateTime @default(now())

  run           OcrTrainingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([version, keyNorm, vendorNorm])
  @@index([version])
  @@map("ocr_correction_rules")
}

enum SplitType {
  EQUAL
  ITEMIZED
  CUSTOM
}
