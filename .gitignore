# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.production

# Build outputs
dist/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
# backend/ml — sorties générées par le pipeline d'entraînement OCR
backend/ml/data/
backend/ml/out/
backend/ml/*.onnx
backend/ml/__pycache__/
backend/ml/*.pyc

# Sauvegardes de base produites par backend/src/scripts/backup-db.ts
# — elles contiennent des donnees personnelles, ne JAMAIS les commiter
splitit-backup-*.json

# Cle du compte de service Google Play — elle autorise a publier sur la fiche
# et sur la piste de production. A NE JAMAIS commiter.
play-service-account*.json
google-play-key*.json
service-account*.json
store/*.key.json

# Signature Android — un keystore fuite permet de signer une fausse mise a jour
*.jks
*.keystore
app/credentials/
